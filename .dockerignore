# Ficheiros e pastas a serem ignorados ao construir a imagem Docker.
# Isto mantém a imagem final mais pequena e segura.

# Ficheiros de cache do Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ambientes virtuais
.env
.venv
venv/

# Metadados de pacotes Python
*.egg-info/

# Ficheiros do Git
.git/
.gitignore

# Testes e ferramentas de desenvolvimento (não são necessários na imagem)
tests/
pytest.ini
.pytest_cache/
.coveragerc
.coverage
htmlcov/
requirements-dev.txt

# Ficheiros do Docker (não precisam de estar dentro da imagem)
Dockerfile
docker-compose.yml
.dockerignore

# Ficheiros de configuração e base de dados (serão montados via volume)
config/
certs/

# Dependências de Frontend (não devem ser copiadas diretamente)
node_modules/

# Os assets gerados: quem os constrói é o estágio de frontend, dentro da
# imagem. Sem esta linha, uma pasta 'dist' da máquina de quem constrói era
# copiada para lá — e o estágio final, que agora copia a pasta INTEIRA,
# levaria consigo qualquer ficheiro velho que lá estivesse.
app/static/dist/
